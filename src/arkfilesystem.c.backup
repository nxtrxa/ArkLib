#include "core/arkbasic_string.h"
#include "io/arkfilesystem.h"

ARK_BEGIN

volatile i32 ark_fsys_err = 0;


struct path {
	ark_basic_string native_path;
	int				 fd;
	bool			 deleted;
	bool			 is_file;
};

struct tree {
	struct path root;
	usz			dir_count;
	struct path children[] __attr_counted_by__ (dir_count);
};

__attr_static_inline__ bool is_file (ark_basic_string path_) {
	if (ARK_MEMCHR (path_.data, '.', path_.len)) {
		return true;
	} else {
		return false;
	}
}

#define NATIVE_PATH(Path_) ark_to_cstr ((Path_)->native_path)

__attr_public_symbol__ ark_fsys_path* ark_fsys_make_path (CString path_) {
	ark_fsys_path* p = ARK_TRY_MALLOC (sizeof (ark_fsys_path));
	if (!p) {
		ARK_WARN ("malloc failed");
		return nullptr;
	}

	int fd = open (path_, O_RDWR | O_CREAT, S_IREAD | S_IWRITE);
	if (fd == -1) {
		ARK_WARN ("failed to open path: %s", path_);
		return nullptr;
	}

	*p = (ark_fsys_path) {
		.native_path = ark_make_basic_string (path_),
		.fd			 = fd,
		.is_file	 = is_file (p->native_path),
	};
	return p;
}


u0 ark_fsys_destroy_path (ark_fsys_path* __noalias__ path_) {
	close (path_->fd);
	ark_destroy_basic_string (&path_->native_path);
	ARK_FREE (path_);
}

ark_string_view ark_fsys_fname (ark_fsys_path* __noalias__ path_) {
	char* dot = ARK_MEMCHR (NATIVE_PATH (path_), '.', path_->native_path.len);
	return ark_make_string_view (path_->native_path.data, path_->native_path.len - ARK_STRLEN (dot));
}

ark_string_view ark_fsys_fext (ark_fsys_path* __noalias__ path_) {
	CString ext = ARK_MEMCHR (NATIVE_PATH (path_), '.', path_->native_path.len);
	ext++;
	return ark_make_string_view (ext);
}

int ark_fsys_frename (ark_fsys_path* __noalias__ path_, CString new_name_) {
	if (rename (NATIVE_PATH (path_), new_name_) == -1) {
		return -1;
	}
	ark_bstrcopy (&path_->native_path, new_name_);
	return 0;
}


int ark_fsys_fdelete (ark_fsys_path* path_) {
	if (remove (NATIVE_PATH (path_)) == -1) {
		return -1;
	}
	path_->deleted = true;
	return 1;
}

